local function LROC_fake_script() -- AntiAfk.LocalScript 
	local script = Instance.new('LocalScript', AntiAfk)

	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local VirtualUser = game:GetService("VirtualUser")
	
	local Player = Players.LocalPlayer
	
	local AntiAFK = true
	
	Player.Idled:Connect(function()
		if AntiAFK then
			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.new())
		end
	end)
	
	local Gui = script.Parent
	local MainFrame = Gui:WaitForChild("MainFrame")
	local ToggleButton = MainFrame:WaitForChild("ToggleButton")
	local Status = MainFrame:WaitForChild("Status")
	
	ToggleButton.MouseButton1Click:Connect(function()
		AntiAFK = not AntiAFK
	
		if AntiAFK then
			Status.Text = "Activated"
			ToggleButton.Text = "Disable"
		else
			Status.Text = "Disabled"
			ToggleButton.Text = "Enable"
		end
	end)
	
	local dragging = false
	local dragStart
	local startPosition
	
	MainFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
	
			dragging = true
			dragStart = input.Position
			startPosition = MainFrame.Position
	
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
	
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
	
			local delta = input.Position - dragStart
	
			MainFrame.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end)
end
coroutine.wrap(LROC_fake_script)()
