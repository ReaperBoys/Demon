	-- ===== Remote spy =====
	local spyConnections = {}
	local spyBound = {}
	
	local function collectRemotes()
		local remotes = {}
		for _, inst in ReplicatedStorage:GetDescendants() do
			if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") then
				table.insert(remotes, inst)
			end
		end
		for _, inst in workspace:GetDescendants() do
			if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") then
				table.insert(remotes, inst)
			end
		end
		return remotes
	end
	
	local function startSpy()
		flags.spying = true
		local eventCount = 0
		for _, remote in collectRemotes() do
			if not spyBound[remote] then
				spyBound[remote] = true
				if remote:IsA("RemoteEvent") then
					local conn = remote.OnClientEvent:Connect(function(...)
						if flags.spying then
							print("[RemoteSpy] OnClientEvent " .. remote:GetFullName(), ...)
						end
					end)
					table.insert(spyConnections, conn)
					eventCount += 1
				else
					remote.OnClientInvoke = function(...)
						if flags.spying then
							print("[RemoteSpy] OnClientInvoke " .. remote:GetFullName(), ...)
						end
					end
				end
			end
		end
		print("[RemoteSpy] started - watching " .. eventCount .. " remote events (client receives)")
	end
	
	local function turtleSpyDump()
		local remotes = collectRemotes()
		print(("[TurtleSpy] %d remotes found:"):format(#remotes))
		for _, remote in remotes do
			print("[TurtleSpy] " .. remote.ClassName .. " | " .. remote:GetFullName())
		end
	end
	
	-- ===== Gym auto-fire (BenchPress / PunchingBag) =====
	local function gymLoop(flagKey, remoteCalls)
		task.spawn(function()
			local remotesFolder = ReplicatedStorage:WaitForChild("Remotes", 5)
			local resolved = {}
			for _, call in remoteCalls do
				local remote = remotesFolder and remotesFolder:FindFirstChild(call.name)
				if remote then
					table.insert(resolved, { remote, call.args })
				else
					warn("[Orbit] remote not found: Remotes/" .. call.name)
				end
			end
			if #resolved == 0 then
				warn("[Orbit] no remotes found for " .. flagKey .. " - stopping loop")
				flags[flagKey] = false
				return
			end
			while flags[flagKey] do
				for _, entry in resolved do
					if not flags[flagKey] then
						break
					end
					pcall(function()
						entry[1]:FireServer(unpack(entry[2]))
					end)
				end
				task.wait()
			end
		end)
	end
	
