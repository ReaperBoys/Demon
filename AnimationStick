local p=game.Players.LocalPlayer
local rs=game:GetService("RunService")

local R6_ID="rbxassetid://your_animation_id"
local R15_ID="rbxassetid://your_animation_id"

local function playAnim(c)
	local h=c:FindFirstChildOfClass("Humanoid")
	if not h then return end

	local id=h.RigType==Enum.HumanoidRigType.R6 and R6_ID or R15_ID
	local a=Instance.new("Animation")
	a.AnimationId=id

	local track=h:LoadAnimation(a)
	track.Looped=true
	track:Play()

	return track
end

p.Chatted:Connect(function(m)
	local u=m:match("^!stick%s+@?(.+)")
	if u then
		local t=game.Players:FindFirstChild(u)
		if t then
			local c=p.Character
			local track=c and playAnim(c)

			rs:BindToRenderStep("Stick",1,function()
				local tc=t.Character
				local hrp=c and c:FindFirstChild("HumanoidRootPart")
				local thrp=tc and tc:FindFirstChild("HumanoidRootPart")

				if hrp and thrp then
					hrp.CFrame=thrp.CFrame*CFrame.new(0,0,2)
				end
			end)
		end
	elseif m:lower()=="!unstick" then
		rs:UnbindFromRenderStep("Stick")

		if p.Character then
			local h=p.Character:FindFirstChildOfClass("Humanoid")
			if h then
				for _,v in ipairs(h:GetPlayingAnimationTracks()) do
					v:Stop()
				end
			end
		end
	end
end)
