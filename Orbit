-- Scripts:

local function UQBDMSB_fake_script() -- Orbit.Orbit.OrbitCommands 
	local script = Instance.new('LocalScript', Orbit.Orbit)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local Lighting = game:GetService("Lighting")
	local TeleportService = game:GetService("TeleportService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	
	local player = Players.LocalPlayer
	local orbit = script.Parent
	local scrolling = orbit:WaitForChild("MainFrame"):WaitForChild("ScrollingFrame")
	
	local DEFAULT_WALKSPEED = 16
	local DEFAULT_JUMPPOWER = 50
	
	local settings = {
		walkSpeed = DEFAULT_WALKSPEED,
		jumpPower = DEFAULT_JUMPPOWER,
		hipHeight = nil,
	}
	
	local flags = {
		flying = false,
		noclipping = false,
		spinSpeed = 0,
		infiniteJump = false,
		moonwalking = false,
		invisible = false,
		headless = false,
		korblox = false,
		dancing = false,
		waving = false,
		floating = false,
		spying = false,
		benching = false,
		punching = false,
	}
	
	-- ===== Helpers =====
	local function getCharacter()
		return player.Character
	end
	
	local function getHumanoid()
		local char = getCharacter()
		return char and char:FindFirstChildOfClass("Humanoid")
	end
	
	local function getRoot()
		local char = getCharacter()
		return char and char:FindFirstChild("HumanoidRootPart")
	end
	
	local function getControl(frameName, controlName)
		local frame = scrolling:FindFirstChild(frameName)
		return frame and frame:FindFirstChild(controlName)
	end
	
	local function wireButton(frameName, buttonName, fn)
		local button = getControl(frameName, buttonName)
		if button then
			button.Activated:Connect(fn)
		else
			warn("[Orbit] missing button " .. frameName .. "/" .. buttonName)
		end
	end
	
	local function wireToggle(frameName, onFn, offFn)
		wireButton(frameName, "ON", onFn)
		wireButton(frameName, "OFF", offFn)
	end
	
	local function bindNumber(frameName, controlName, label, callback)
		local control = getControl(frameName, controlName)
		if not control then
			warn("[Orbit] missing textbox " .. frameName .. "/" .. controlName)
			return
		end
		control.FocusLost:Connect(function()
			local value = tonumber(control.Text)
			if value then
				callback(value)
				print(("[Orbit] %s set to %s"):format(label, tostring(value)))
			else
				warn("[Orbit] '" .. tostring(control.Text) .. "' is not a valid number for " .. label)
			end
		end)
	end
	
	local function stopEmoteTracks()
		local hum = getHumanoid()
		if not hum then
			return
		end
		local animator = hum:FindFirstChildOfClass("Animator")
		if animator then
			for _, track in animator:GetPlayingAnimationTracks() do
				track:Stop(0.1)
			end
		end
	end
	
	local function emoteLoop(emoteName, flagKey)
		task.spawn(function()
			while flags[flagKey] do
				local hum = getHumanoid()
				if hum then
					pcall(function()
						hum:PlayEmote(emoteName)
					end)
					task.wait(0.25)
				else
					task.wait(0.5)
				end
			end
		end)
	end
	
	-- ===== Continuous loops =====
	RunService.RenderStepped:Connect(function(dt)
		local root = getRoot()
		local hum = getHumanoid()
		if not root or not hum then
			return
		end
	
		if flags.flying then
			local velocity = hum.MoveDirection * 60
			if UserInputService:IsKeyDown(Enum.KeyCode.E) then
				velocity += Vector3.new(0, 60, 0)
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Q) then
				velocity -= Vector3.new(0, 60, 0)
			end
			root.AssemblyLinearVelocity = velocity
		end
	
		if flags.spinSpeed ~= 0 then
			root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(flags.spinSpeed) * dt, 0)
		end
	
		if flags.moonwalking and hum.MoveDirection.Magnitude > 0.05 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position - hum.MoveDirection)
		end
	end)
	
